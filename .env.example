[TEMPLATE]
# YouTube Automation - Environment Variables

# ========================================
# API Keys — AI Providers
# ========================================
# At least ONE of these is required for AI-powered script/scene generation.
# The system tries Groq first, then falls back to OpenRouter if all
# Groq models fail. If neither is configured, built-in templates are used.

# Groq API Key (free tier)
# Get: https://console.groq.com/keys
# Models: llama-3.3-70b, llama-3.1-8b, mixtral-8x7b
# GROQ_API_KEY=gsk_your_key_here

# OpenRouter API Key (free tier)
# Get: https://openrouter.ai/keys
# Models: deepseek-v4-flash, llama-3.3-70b, gemma-4-31b, nemotron-120b, minimax-m2.5
# OPENROUTER_API_KEY=sk_or_key_here

# short-video-maker sidecar
PEXELS_API_KEY=your_free_pexels_api_key_here
